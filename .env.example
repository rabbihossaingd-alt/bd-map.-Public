# Copy this file to ".env" (same folder) and fill it in. The .env file stays on your computer: it is never
# uploaded to GitHub and the server never shows it to anyone.

# Who is the admin (comma separated for more than one)
ADMIN_EMAILS=rabbihossaingd@gmail.com

# The mail account that sends the login codes.
# With Gmail: turn on 2-Step Verification, then make an "App password" at
# https://myaccount.google.com/apppasswords and paste its 16 letters below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-address@gmail.com
SMTP_PASS=

# Optional: where the database is kept, and a relay server so calls work on mobile data
# DATA_DIR=
# TURN_URL=
# TURN_USER=
# TURN_PASS=
